{
  "name": "dsh-harness-panel",
  "version": "0.2.0",
  "description": "Harness settings section for DeepSeek Harness: MCP server status and start/stop, the session skill catalog with enable/disable, and hook bridge start/stop, in one native-styled page.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "skills",
    "hooks",
    "panel"
  ],
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.1",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "bunx --bun tsdown || tsdown",
    "typecheck": "bunx --bun tsc --noEmit || tsc --noEmit",
    "test": "bunx --bun vitest run || vitest run",
    "prepare": "bunx --bun tsdown || tsdown"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.7.0"
}
